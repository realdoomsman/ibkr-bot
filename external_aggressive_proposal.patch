+class VolatilityBreakout(Strategy):
+    """NEW: Volatility breakout - trade explosive volatility spikes.
+
+    Entry: When price breaks out by volatility multiple
+    Exit: When volatility collapses
+    """
+
+    def __init__(self, period: int = 20, vol_mult: float = 2.5):
+        self.period = int(period)
+        self.vol_mult = float(vol_mult)
+        self.warmup = self.period * 2
+
+    def target_position(self, bars: pd.DataFrame, current: float = 0.0) -> float:
+        if len(bars) < self.warmup:
+            return 0.0
+
+        close = bars["close"]
+        returns = close.pct_change().dropna()
+        recent_returns = returns.iloc[-self.period:]
+
+        # Calculate volatility
+        vol = recent_returns.std()
+        current_return = returns.iloc[-1] if len(returns) > 0 else 0
+
+        # Entry: explosive move (multiple of volatility)
+        if abs(current_return) > vol * self.vol_mult:
+            return 1.0 if current_return > 0 else -1.0  # Long or short
+
+        # Exit: volatility collapses
+        if current > 0 and abs(current_return) < vol * 0.5:
+            return 0.0
+        elif current < 0 and abs(current_return) < vol * 0.5:
+            return 0.0
+
+        return current
+
+    @classmethod
+    def param_grid(cls) -> list[dict]:
+        return [
+            {"period": 20, "vol_mult": 2.0},
+            {"period": 20, "vol_mult": 2.5},
