+                 stop_threshold: float = 0.005):
+        self.period = int(period)
+        self.breakout_threshold = float(breakout_threshold)
+        self.stop_threshold = float(stop_threshold)
+        self.warmup = self.period + 1
+
+    def target_position(self, bars: pd.DataFrame, current: float = 0.0) -> float:
+        if len(bars) < self.warmup:
+            return 0.0
+
+        close = bars["close"]
+        recent_high = close.iloc[-self.period-1:-1].max()
+        recent_low = close.iloc[-self.period-1:-1].min()
+        current_price = close.iloc[-1]
+
+        # Buy signal: explosive breakout above recent high
+        if current_price > recent_high * (1 + self.breakout_threshold):
+            return 1.0
+
+        # Exit signal: drop below recent low
+        if current_price < recent_low * (1 - self.stop_threshold):
+            return 0.0
+
+        return current
+
+    @classmethod
+    def param_grid(cls) -> list[dict]:
+        return [
+            {"period": p, "breakout_threshold": bt, "stop_threshold": st}
+            for p, bt, st in [(5, 0.005, 0.003), (10, 0.01, 0.005), (10, 0.015, 0.008)]
