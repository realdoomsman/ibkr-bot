+class AggressiveBreakout(Strategy):
+    """ULTRA-AGGRESSIVE breakout strategy: buy on explosive momentum breaks.
+
+    Entry: When price breaks above recent high by tiny threshold
+    Exit: When price falls below recent low
+    """
+
