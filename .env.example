# Copy this file to .env (or set these in your environment).
# NONE of these are required for paper trading or backtesting.

# Optional: enables the AI market-analysis module (bot/ai_analyst.py).
# Get a key at https://platform.claude.com/ - costs real money per API call.
ANTHROPIC_API_KEY=

# DO NOT SET THIS until you have months of profitable paper trading.
# Setting it to "yes" is the only way the bot will connect to a live account.
I_UNDERSTAND_LIVE_TRADING_RISKS=
