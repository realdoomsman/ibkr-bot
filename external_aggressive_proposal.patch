+class MeanReversion(Strategy):
+    """NEW: Ultra-fast mean reversion for extreme reversals.
+
+    Entry: Price deviates extremely from mean
+    Exit: Price returns to mean
+    """
+
+    def __init__(self, period: int = 10, z_threshold: float = 2.0):
+        self.period = int(period)
+        self.z_threshold = float(z_threshold)
+        self.warmup = self.period + 1
+
+    def target_position(self, bars: pd.DataFrame, current: float = 0.0) -> float:
+        if len(bars) < self.warmup:
+            return 0.0
+
+        close = bars["close"]
+        recent = close.iloc[-self.period-1:-1]
+        mean = recent.mean()
+        std = recent.std()
+        current_price = close.iloc[-1]
+
+        # Calculate Z-score
+        if std == 0:
+            return current
+
+        z = (current_price - mean) / std
+
+        # Entry: extreme deviation
+        if z < -self.z_threshold:
+            return 1.0  # Oversold - buy
+        elif z > self.z_threshold:
+            return -1.0  # Overbought - short
+
+        # Exit: returned to mean
+        if abs(z) < 0.5:
+            return 0.0
+
+        return current
+
+    @classmethod
+    def param_grid(cls) -> list[dict]:
+        return [
+            {"period": 10, "z_threshold": 2.0},
+            {"period": 10, "z_threshold": 2.5},
+            {"period": 5, "z_threshold": 3.0},
+        ]
 
 
